{
  "name": "filo-barberia",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de reservas online para Filo Barbería",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @filo/web build && pnpm --filter @filo/api build",
    "start": "pnpm --filter @filo/api start",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "db:reset": "pnpm --filter @filo/api db:reset"
  }
}
